---
import '../styles/global.css';
const {title='mino. — 아직 생각 중입니다.',description='기술과 과학, 인간과 사회에 관해 질문하고 기록합니다.'}=Astro.props;
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description}/>
<link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<title>{title}</title>
<!-- Cloudflare Web Analytics --><script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"c004b7eb0d0347e590b5224c76abcd5b"}'></script><!-- End Cloudflare Web Analytics -->
</head>
<body><div class="wrap">
<header class="nav"><a class="brand" href="/">mino.</a><nav aria-label="주 메뉴" class="navlinks"><a href="/">글</a><a href="/about/">소개</a></nav></header>
<slot/>
<footer class="footer">© {new Date().getFullYear()} mino. · 생각하고, 질문하고, 기록합니다.</footer>
</div></body></html>
