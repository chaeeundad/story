---
import '../styles/global.css';
interface Props {
 title?: string;
 description?: string;
 type?: 'website' | 'article';
 publishedTime?: string;
 tags?: string[];
 author?: string;
}
const {
  title='mino. — 아직 생각 중입니다.',
  description='기술과 과학, 역사와 사회에 대한 질문을 기록하는 개인 서재. AI와의 대화에서 출발한 생각들을 긴 글로 정리합니다.',
  type='website',
  publishedTime,
  tags=[],
  author='mino'
}=Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://mino.co.kr').href;
const jsonLd = type==='article' ? {
 '@context':'https://schema.org',
 '@type':'BlogPosting',
 headline:title.replace(/ — mino\.$/,''),
 description,
 mainEntityOfPage:canonical,
 url:canonical,
 inLanguage:'ko-KR',
 datePublished: publishedTime,
 author:{'@type':'Person',name:author,url:'https://mino.co.kr/about/'},
 publisher:{'@type':'Person',name:'mino',url:'https://mino.co.kr/about/'},
 keywords: tags.join(', ')
} : {
 '@context':'https://schema.org',
 '@type':'WebSite',
 name:'mino.',
 url:'https://mino.co.kr/',
 inLanguage:'ko-KR',
 description:'기술과 과학, 역사와 사회에 대한 질문을 기록하는 개인 서재.'
};
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="naver-site-verification" content="78379512db4c1e3c3478cbcf8a4c2d46ed8f02e1" />
<meta name="description" content={description}/>
<meta name="robots" content="index, follow, max-image-preview:large"/>
<link rel="canonical" href={canonical}/>
<meta property="og:locale" content="ko_KR"/>
<meta property="og:site_name" content="mino."/>
<meta property="og:type" content={type}/>
<meta property="og:url" content={canonical}/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta name="twitter:card" content="summary"/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/>
{type==='article' && publishedTime && <meta property="article:published_time" content={publishedTime}/>}
{type==='article' && tags.map(tag=><meta property="article:tag" content={tag}/>)}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g,'\\u003c')} />
<title>{title}</title>
<link rel="stylesheet" href="/reading.css" />

</head>
<body><a class="skip-link" href="#main-content">본문으로 건너뛰기</a><div class="wrap">
<header class="nav"><a class="brand" href="/">mino.</a><nav aria-label="주 메뉴" class="navlinks"><a href="/">글</a><a href="/about/">소개</a></nav></header>
<main id="main-content" tabindex="-1"><slot/></main>
<footer class="footer">© {new Date().getFullYear()} mino. · 생각하고, 질문하고, 기록합니다.</footer>
</div></body></html>
