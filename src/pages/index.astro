---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
// Stable publication order when multiple essays share the same publication date.
const sameDayOrder = [
  'let-me-live-my-own-life',
  'when-we-accept-the-world-we-made',
  'why-we-need-each-other',
  'why-we-still-build',
  'we-built-what-we-do-not-understand',
  'does-humanity-need-to-work',
  'why-go-fishing',
  'why-children-study',
  'why-we-work',
];
const rank = new Map(sameDayOrder.map((id, index) => [id, index]));
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>
  b.data.pubDate.valueOf()-a.data.pubDate.valueOf()
  || (rank.get(a.id) ?? Number.MAX_SAFE_INTEGER)-(rank.get(b.id) ?? Number.MAX_SAFE_INTEGER)
  || a.id.localeCompare(b.id)
);
---
<Base title="mino. — 아직 생각 중입니다." description="기술과 과학, 역사와 사회에 관한 질문을 AI와의 대화를 통해 확장하고 기록하는 개인 서재입니다.">
<section class="intro"><div class="eyebrow">생각하고, 질문하고, 기록합니다.</div><h1>아직 생각 중입니다.</h1><p class="lead">기술과 과학, 인간과 사회에 관해 궁금했던 것들.<br/>답을 찾는 과정에서 새롭게 발견한 생각들을 기록합니다.</p></section>
<section><h2 class="section-head">글</h2>
{posts.map(post=><a class="post" href={post.data.legacyUrl ?? `/writing/${post.id}/`}>
<div class="meta">{post.data.pubDate.toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric'})} · {post.data.tags.join(' · ')}</div>
<h2>{post.data.title}</h2><p>{post.data.description}</p>
</a>)}
</section></Base>
